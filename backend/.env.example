# Database
DATABASE_URL="postgresql://user:password@localhost:5432/medicare"

# JWT
JWT_SECRET="your-very-long-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="your-refresh-secret-key"
JWT_REFRESH_EXPIRES_IN="30d"

# Server
PORT=5000
NODE_ENV="development"
API_VERSION="v1"

# CORS
CORS_ORIGIN="http://localhost:3000"

# Email Configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="MediCare <noreply@medicare.tn>"

# SMS Provider (Twilio)
SMS_PROVIDER="twilio"
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+21612345678"

# File Upload
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES="image/jpeg,image/png,image/jpg,application/pdf,application/dicom"

# Encryption
ENCRYPTION_KEY="your-32-character-encryption-key-here"
ENCRYPTION_ALGORITHM="aes-256-gcm"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session
SESSION_SECRET="your-session-secret"

# Logging
LOG_LEVEL="info"
LOG_DIR="./logs"

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Frontend URL
FRONTEND_URL="http://localhost:3000"

# Super Admin Default
SUPER_ADMIN_EMAIL="admin@medicare.tn"
SUPER_ADMIN_PASSWORD="ChangeMe123!"
