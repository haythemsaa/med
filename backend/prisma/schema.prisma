// MediCare SaaS - Database Schema
// PostgreSQL + Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  SUPER_ADMIN
  ADMIN_CABINET
  PRACTITIONER
  SECRETARY
  PARAMEDICAL
  RADIOLOGIST
  LABORATORY
  PATIENT
}

enum PractitionerType {
  GENERAL_PRACTITIONER
  SPECIALIST
  DENTIST
  OPHTHALMOLOGIST
  DERMATOLOGIST
  CARDIOLOGIST
  PEDIATRICIAN
  GYNECOLOGIST
  PSYCHIATRIST
  PHYSIOTHERAPIST
  NUTRITIONIST
  PSYCHOLOGIST
  NURSE
  RADIOLOGIST
  LABORATORY_TECH
  OTHER
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  ARRIVED
  IN_CONSULTATION
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentType {
  CONSULTATION
  TELECONSULTATION
  FIRST_VISIT
  FOLLOW_UP
  EMERGENCY
  CHECK_UP
  VACCINATION
  IMAGING
  LABORATORY
  OTHER
}

enum NotificationType {
  SMS
  EMAIL
  WHATSAPP
  PUSH
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  READ
}

enum DocumentType {
  PRESCRIPTION
  LAB_RESULT
  IMAGING
  REPORT
  INVOICE
  CONSENT_FORM
  VACCINATION_CARD
  SICK_LEAVE
  OTHER
}

enum SubscriptionPlan {
  FREE
  STARTER
  STANDARD
  PREMIUM
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  TRIAL
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  CHECK
  INSURANCE
  OTHER
}

enum PrescriptionStatus {
  DRAFT
  ISSUED
  DISPENSED
  PARTIALLY_DISPENSED
  CANCELLED
  EXPIRED
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  ARCHIVED
}

enum ReminderType {
  APPOINTMENT_CONFIRMATION
  APPOINTMENT_REMINDER_24H
  APPOINTMENT_REMINDER_1H
  FOLLOW_UP
  MEDICATION_REMINDER
  VACCINATION_DUE
  CUSTOM
}

// ============================================
// MODELS
// ============================================

// User Model - Central authentication table
model User {
  id                String    @id @default(uuid())
  email             String    @unique
  phone             String?   @unique
  password          String
  role              UserRole
  isActive          Boolean   @default(true)
  isEmailVerified   Boolean   @default(false)
  isPhoneVerified   Boolean   @default(false)
  lastLogin         DateTime?
  passwordChangedAt DateTime?
  passwordResetToken String?
  passwordResetExpires DateTime?
  twoFactorEnabled  Boolean   @default(false)
  twoFactorSecret   String?
  refreshToken      String?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  cabinet           Cabinet?  @relation("CabinetAdmin")
  practitioner      Practitioner?
  patient           Patient?
  secretary         Secretary?
  createdCabinets   Cabinet[] @relation("CreatedBy")
  auditLogs         AuditLog[]
  notifications     Notification[]

  @@index([email])
  @@index([phone])
  @@map("users")
}

// Cabinet Model - Multi-tenant structure
model Cabinet {
  id                String    @id @default(uuid())
  name              String
  slug              String    @unique
  description       String?
  logo              String?

  // Contact
  email             String
  phone             String
  address           String?
  city              String?
  postalCode        String?
  country           String    @default("TN")

  // Settings
  timezone          String    @default("Africa/Tunis")
  locale            String    @default("fr")
  currency          String    @default("TND")

  // Booking settings
  allowOnlineBooking Boolean  @default(true)
  minBookingDelay   Int       @default(120) // minutes
  maxBookingDelay   Int       @default(90) // days
  defaultAppointmentDuration Int @default(30) // minutes

  // Notifications
  smsEnabled        Boolean   @default(true)
  emailEnabled      Boolean   @default(true)
  whatsappEnabled   Boolean   @default(false)

  // Subscription
  subscriptionId    String?
  subscriptionPlan  SubscriptionPlan @default(FREE)
  subscriptionStatus SubscriptionStatus @default(TRIAL)
  subscriptionEndsAt DateTime?
  trialEndsAt       DateTime?

  // Quotas
  smsQuota          Int       @default(100)
  smsUsed           Int       @default(0)
  emailQuota        Int       @default(1000)
  emailUsed         Int       @default(0)
  storageQuota      BigInt    @default(1073741824) // 1GB in bytes
  storageUsed       BigInt    @default(0)

  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  adminId           String    @unique
  admin             User      @relation("CabinetAdmin", fields: [adminId], references: [id])
  createdById       String?
  createdBy         User?     @relation("CreatedBy", fields: [createdById], references: [id])

  practitioners     Practitioner[]
  secretaries       Secretary[]
  patients          Patient[]
  appointments      Appointment[]
  rooms             Room[]
  schedules         Schedule[]
  absences          Absence[]
  consultations     Consultation[]
  documents         Document[]
  invoices          Invoice[]
  settings          CabinetSetting[]

  @@index([slug])
  @@index([subscriptionStatus])
  @@map("cabinets")
}

// Practitioner Model
model Practitioner {
  id                String    @id @default(uuid())
  userId            String    @unique
  cabinetId         String

  // Personal info
  firstName         String
  lastName          String
  title             String?   // Dr., Prof., etc.
  speciality        PractitionerType
  specialityDetails String?

  // Professional info
  licenseNumber     String?
  orderNumber       String?   // Numéro d'inscription à l'ordre
  bio               String?
  photo             String?

  // Settings
  consultationFee   Decimal?  @db.Decimal(10, 3)
  teleconsultationFee Decimal? @db.Decimal(10, 3)
  allowTeleconsultation Boolean @default(false)
  color             String?   // For calendar display

  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cabinet           Cabinet   @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  appointments      Appointment[]
  schedules         Schedule[]
  absences          Absence[]
  consultations     Consultation[]

  @@index([cabinetId])
  @@index([speciality])
  @@map("practitioners")
}

// Secretary Model
model Secretary {
  id                String    @id @default(uuid())
  userId            String    @unique
  cabinetId         String

  firstName         String
  lastName          String
  phone             String?

  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cabinet           Cabinet   @relation(fields: [cabinetId], references: [id], onDelete: Cascade)

  @@index([cabinetId])
  @@map("secretaries")
}

// Patient Model
model Patient {
  id                String    @id @default(uuid())
  userId            String?   @unique
  cabinetId         String

  // Personal info
  firstName         String
  lastName          String
  dateOfBirth       DateTime
  gender            Gender
  photo             String?

  // Contact
  email             String?
  phone             String
  address           String?
  city              String?
  postalCode        String?

  // Medical info
  bloodGroup        BloodGroup?
  allergies         String?
  chronicDiseases   String?
  currentMedications String?
  emergencyContact  String?
  emergencyPhone    String?

  // Insurance
  insuranceCompany  String?
  insuranceNumber   String?

  // Stats
  noShowCount       Int       @default(0)
  lastNoShowAt      DateTime?
  totalVisits       Int       @default(0)

  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  user              User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  cabinet           Cabinet   @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  appointments      Appointment[]
  consultations     Consultation[]
  documents         Document[]
  invoices          Invoice[]

  @@index([cabinetId])
  @@index([phone])
  @@index([email])
  @@map("patients")
}

// Appointment Model
model Appointment {
  id                String    @id @default(uuid())
  cabinetId         String
  practitionerId    String
  patientId         String
  roomId            String?

  // Appointment details
  type              AppointmentType
  status            AppointmentStatus @default(SCHEDULED)
  startTime         DateTime
  endTime           DateTime
  duration          Int       // minutes

  // Booking info
  isOnlineBooking   Boolean   @default(false)
  confirmationSentAt DateTime?
  reminderSentAt    DateTime?

  // Patient info
  reason            String?
  notes             String?

  // Status tracking
  arrivedAt         DateTime?
  consultationStartedAt DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  cancelReason      String?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  cabinet           Cabinet   @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  practitioner      Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  patient           Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  room              Room?     @relation(fields: [roomId], references: [id], onDelete: SetNull)
  consultation      Consultation?
  invoice           Invoice?
  teleconsultation  Teleconsultation?
  waitingRoom       WaitingRoom?

  @@index([cabinetId])
  @@index([practitionerId])
  @@index([patientId])
  @@index([startTime])
  @@index([status])
  @@map("appointments")
}

// Consultation Model - Medical record of visit
model Consultation {
  id                String    @id @default(uuid())
  cabinetId         String
  appointmentId     String    @unique
  practitionerId    String
  patientId         String

  // Consultation data
  chiefComplaint    String?   // Motif de consultation
  presentIllness    String?   // Histoire de la maladie

  // Physical examination
  height            Decimal?  @db.Decimal(5, 2) // cm
  weight            Decimal?  @db.Decimal(5, 2) // kg
  bloodPressureSystolic Int?
  bloodPressureDiastolic Int?
  heartRate         Int?
  temperature       Decimal?  @db.Decimal(4, 2)
  oxygenSaturation  Int?

  // Clinical findings
  clinicalFindings  String?

  // Diagnosis
  diagnosisPrimary  String?
  diagnosisSecondary String?
  icdCodes          String?   // ICD-10 codes

  // Treatment
  prescription      String?   // JSON or text
  recommendations   String?

  // Follow-up
  followUpDate      DateTime?
  followUpNotes     String?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  cabinet           Cabinet   @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  appointment       Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  practitioner      Practitioner @relation(fields: [practitionerId], references: [id])
  patient           Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  documents         Document[]

  @@index([cabinetId])
  @@index([patientId])
  @@index([practitionerId])
  @@map("consultations")
}

// Document Model - Medical documents
model Document {
  id                String    @id @default(uuid())
  cabinetId         String
  patientId         String
  consultationId    String?

  type              DocumentType
  title             String
  description       String?

  // File info
  fileName          String
  filePath          String
  fileSize          BigInt
  mimeType          String

  // Encryption
  isEncrypted       Boolean   @default(true)
  encryptionKey     String?

  // Metadata
  uploadedBy        String?   // User ID
  tags              String?   // JSON array

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  cabinet           Cabinet   @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  patient           Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultation      Consultation? @relation(fields: [consultationId], references: [id], onDelete: SetNull)

  @@index([cabinetId])
  @@index([patientId])
  @@index([type])
  @@map("documents")
}

// Schedule Model - Practitioner working hours
model Schedule {
  id                String    @id @default(uuid())
  cabinetId         String
  practitionerId    String

  dayOfWeek         Int       // 0=Sunday, 1=Monday, ..., 6=Saturday
  startTime         String    // Format: "HH:MM"
  endTime           String    // Format: "HH:MM"

  isActive          Boolean   @default(true)

  // Relations
  cabinet           Cabinet   @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  practitioner      Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)

  @@unique([practitionerId, dayOfWeek])
  @@index([cabinetId])
  @@map("schedules")
}

// Absence Model - Practitioner absences
model Absence {
  id                String    @id @default(uuid())
  cabinetId         String
  practitionerId    String

  startDate         DateTime
  endDate           DateTime
  reason            String?
  isAllDay          Boolean   @default(true)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  cabinet           Cabinet   @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  practitioner      Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)

  @@index([cabinetId])
  @@index([practitionerId])
  @@map("absences")
}

// Room Model - Consultation rooms
model Room {
  id                String    @id @default(uuid())
  cabinetId         String

  name              String
  description       String?
  floor             String?
  capacity          Int       @default(1)

  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  cabinet           Cabinet   @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  appointments      Appointment[]

  @@index([cabinetId])
  @@map("rooms")
}

// Notification Model
model Notification {
  id                String    @id @default(uuid())
  userId            String?

  type              NotificationType
  status            NotificationStatus @default(PENDING)

  // Recipient
  recipientEmail    String?
  recipientPhone    String?

  // Content
  subject           String?
  message           String

  // Metadata
  metadata          String?   // JSON data

  // Tracking
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedAt          DateTime?
  errorMessage      String?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  user              User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([type])
  @@map("notifications")
}

// Invoice Model - Billing
model Invoice {
  id                String    @id @default(uuid())
  cabinetId         String
  patientId         String
  appointmentId     String?   @unique

  invoiceNumber     String    @unique

  // Amounts
  subtotal          Decimal   @db.Decimal(10, 3)
  tax               Decimal   @default(0) @db.Decimal(10, 3)
  discount          Decimal   @default(0) @db.Decimal(10, 3)
  total             Decimal   @db.Decimal(10, 3)

  // Payment
  paymentStatus     PaymentStatus @default(PENDING)
  paymentMethod     PaymentMethod?
  paidAmount        Decimal   @default(0) @db.Decimal(10, 3)
  paidAt            DateTime?

  // Dates
  issueDate         DateTime  @default(now())
  dueDate           DateTime?

  notes             String?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  cabinet           Cabinet   @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  patient           Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment       Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([cabinetId])
  @@index([patientId])
  @@index([paymentStatus])
  @@map("invoices")
}

// Cabinet Settings Model - Flexible key-value settings
model CabinetSetting {
  id                String    @id @default(uuid())
  cabinetId         String

  key               String
  value             String

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  cabinet           Cabinet   @relation(fields: [cabinetId], references: [id], onDelete: Cascade)

  @@unique([cabinetId, key])
  @@index([cabinetId])
  @@map("cabinet_settings")
}

// Teleconsultation Model - Video consultation sessions
model Teleconsultation {
  id                String    @id @default(uuid())
  appointmentId     String    @unique

  // Session details
  sessionId         String?   @unique
  roomUrl           String?
  roomToken         String?

  // Status
  status            AppointmentStatus @default(SCHEDULED)

  // Timing
  scheduledAt       DateTime
  startedAt         DateTime?
  endedAt           DateTime?
  duration          Int?      // minutes

  // Participants
  practitionerJoinedAt DateTime?
  patientJoinedAt   DateTime?

  // Recording
  recordingEnabled  Boolean   @default(false)
  recordingUrl      String?

  // Technical
  connectionQuality String?   // good, medium, poor
  techIssues        String?   // JSON log of issues

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  appointment       Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@index([sessionId])
  @@map("teleconsultations")
}

// Waiting Room Model - Virtual waiting for teleconsultations
model WaitingRoom {
  id                String    @id @default(uuid())
  appointmentId     String    @unique

  // Patient status
  patientJoinedAt   DateTime?
  patientReadyAt    DateTime?
  estimatedWaitTime Int?      // minutes

  // Practitioner notification
  practitionerNotifiedAt DateTime?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  appointment       Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@map("waiting_rooms")
}

// Questionnaire Model - Pre-consultation forms
model Questionnaire {
  id                String    @id @default(uuid())
  cabinetId         String

  title             String
  description       String?

  // Configuration
  isActive          Boolean   @default(true)
  isRequired        Boolean   @default(false)
  showBeforeBooking Boolean   @default(true)

  // Questions (JSON structure)
  questions         Json      // [{id, type, text, options, required}]

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  responses         QuestionnaireResponse[]

  @@index([cabinetId])
  @@map("questionnaires")
}

// Questionnaire Response Model
model QuestionnaireResponse {
  id                String    @id @default(uuid())
  questionnaireId   String
  patientId         String
  appointmentId     String?

  // Answers (JSON structure)
  answers           Json      // [{questionId, answer}]

  completedAt       DateTime  @default(now())

  // Relations
  questionnaire     Questionnaire @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)

  @@index([questionnaireId])
  @@index([patientId])
  @@map("questionnaire_responses")
}

// Consent Record Model - RGPD/GDPR compliance
model ConsentRecord {
  id                String    @id @default(uuid())
  patientId         String

  // Consent details
  consentType       String    // data_processing, marketing, teleconsultation, etc.
  consentGiven      Boolean
  consentText       String?   // The text that was shown

  // Electronic signature
  signatureData     String?   // Base64 signature image
  ipAddress         String?
  userAgent         String?

  // Dates
  consentDate       DateTime  @default(now())
  expiryDate        DateTime?
  withdrawnAt       DateTime?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([patientId])
  @@index([consentType])
  @@map("consent_records")
}

// Public Booking Page Model - Custom branded booking pages
model PublicBookingPage {
  id                String    @id @default(uuid())
  cabinetId         String    @unique

  // URL configuration
  slug              String    @unique
  customDomain      String?

  // Branding
  primaryColor      String    @default("#1976d2")
  secondaryColor    String    @default("#dc004e")
  logo              String?
  headerImage       String?

  // Content
  welcomeMessage    String?
  description       String?
  showPractitioners Boolean   @default(true)
  showReviews       Boolean   @default(false)

  // Settings
  isActive          Boolean   @default(true)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([slug])
  @@map("public_booking_pages")
}

// Analytics Model - Track usage and metrics
model Analytics {
  id                String    @id @default(uuid())
  cabinetId         String

  // Metrics
  metric            String    // appointments_created, no_shows, revenue, etc.
  value             Decimal   @db.Decimal(15, 2)
  count             Int       @default(1)

  // Dimensions
  date              DateTime
  practitionerId    String?
  metadata          Json?     // Additional context

  createdAt         DateTime  @default(now())

  @@index([cabinetId])
  @@index([metric])
  @@index([date])
  @@map("analytics")
}

// E-Prescription Model - OBLIGATOIRE France 2025!
model Prescription {
  id                String              @id @default(uuid())
  cabinetId         String
  consultationId    String?
  patientId         String
  practitionerId    String

  // Prescription Details
  prescriptionNumber String            @unique
  qrCode            String              @unique
  status            PrescriptionStatus  @default(DRAFT)

  // Medical Info
  diagnosis         String?
  notes             String?
  validUntil        DateTime

  // Dispensing
  dispensedAt       DateTime?
  dispensedBy       String?             // Pharmacy info

  // Electronic Signature (CPS - Carte Professionnelle de Santé)
  signedAt          DateTime?
  signature         String?

  // Integration with Mon Espace Santé / DMP
  sentToDMP         Boolean             @default(false)
  dmpReference      String?

  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  // Relations
  items             PrescriptionItem[]

  @@index([cabinetId])
  @@index([patientId])
  @@index([practitionerId])
  @@index([prescriptionNumber])
  @@index([qrCode])
  @@map("prescriptions")
}

// Prescription Item Model
model PrescriptionItem {
  id                String        @id @default(uuid())
  prescriptionId    String

  // Medication Details
  medicationName    String
  medicationCode    String?       // CIS code (France)
  dosage            String
  quantity          String
  duration          String?
  instructions      String

  // Dispensing
  dispensed         Boolean       @default(false)
  dispensedQuantity String?
  dispensedAt       DateTime?

  // Substitution
  substitutionAllowed Boolean     @default(true)

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Relations
  prescription      Prescription  @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
  @@map("prescription_items")
}

// Review Model - Patient Reviews & Ratings
model Review {
  id                String    @id @default(uuid())
  cabinetId         String
  patientId         String
  practitionerId    String?
  appointmentId     String?   @unique

  // Rating (1-5 stars)
  overallRating     Int       // 1-5
  waitTimeRating    Int?      // 1-5
  staffRating       Int?      // 1-5
  facilityRating    Int?      // 1-5

  // Review Content
  title             String?
  comment           String?

  // Moderation
  isApproved        Boolean   @default(false)
  isPublic          Boolean   @default(false)
  moderatedAt       DateTime?
  moderatedBy       String?

  // Response
  response          String?
  respondedAt       DateTime?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([cabinetId])
  @@index([patientId])
  @@index([practitionerId])
  @@index([overallRating])
  @@index([isApproved])
  @@map("reviews")
}

// Automated Reminder Model - Advanced Reminder System
model AutomatedReminder {
  id                String        @id @default(uuid())
  cabinetId         String
  appointmentId     String?
  patientId         String

  // Reminder Configuration
  type              ReminderType
  scheduledFor      DateTime
  sentAt            DateTime?

  // Delivery Method
  sendSMS           Boolean       @default(true)
  sendEmail         Boolean       @default(true)
  sendPush          Boolean       @default(false)

  // Content
  subject           String?
  message           String

  // Status
  status            NotificationStatus @default(PENDING)
  attempts          Int           @default(0)
  lastAttemptAt     DateTime?
  errorMessage      String?

  // Tracking
  deliveredAt       DateTime?
  readAt            DateTime?

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([cabinetId])
  @@index([appointmentId])
  @@index([patientId])
  @@index([scheduledFor])
  @@index([status])
  @@map("automated_reminders")
}

// Payment Model - Online Payment Integration
model Payment {
  id                String        @id @default(uuid())
  cabinetId         String
  invoiceId         String?       @unique
  patientId         String
  appointmentId     String?

  // Payment Details
  amount            Decimal       @db.Decimal(10, 3)
  currency          String        @default("TND")
  method            PaymentMethod
  status            PaymentStatus

  // Stripe/PayPal Integration
  stripePaymentId   String?       @unique
  stripeChargeId    String?
  paypalOrderId     String?

  // Transaction Details
  description       String?
  receiptUrl        String?
  receiptNumber     String?       @unique

  // Refund
  refundedAmount    Decimal?      @db.Decimal(10, 3)
  refundedAt        DateTime?
  refundReason      String?

  // Metadata
  metadata          Json?

  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([cabinetId])
  @@index([patientId])
  @@index([status])
  @@index([stripePaymentId])
  @@map("payments")
}

// Message Model - Secure Messaging
model Message {
  id                String        @id @default(uuid())
  cabinetId         String

  // Participants
  senderId          String
  recipientId       String

  // Message Content
  subject           String?
  content           String
  attachments       Json?         // Array of file URLs

  // Status
  status            MessageStatus @default(SENT)
  readAt            DateTime?

  // Threading
  threadId          String?
  replyToId         String?

  // Flags
  isUrgent          Boolean       @default(false)
  isArchived        Boolean       @default(false)

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([cabinetId])
  @@index([senderId])
  @@index([recipientId])
  @@index([threadId])
  @@index([status])
  @@map("messages")
}

// Vaccination Record Model - Digital Vaccination Card
model VaccinationRecord {
  id                String    @id @default(uuid())
  cabinetId         String
  patientId         String
  practitionerId    String?

  // Vaccine Details
  vaccineName       String
  vaccineCode       String?   // CIS code
  diseaseName       String
  manufacturer      String?
  batchNumber       String?
  expiryDate        DateTime?

  // Administration
  administeredAt    DateTime
  administeredBy    String?
  site              String?   // Injection site
  route             String?   // IM, SC, etc.
  dose              String?
  doseNumber        Int?
  totalDoses        Int?

  // Next Dose
  nextDoseDate      DateTime?
  nextDoseReminder  Boolean   @default(true)

  // Integration
  sentToDMP         Boolean   @default(false)
  dmpReference      String?

  // Documentation
  notes             String?
  reactions         String?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([cabinetId])
  @@index([patientId])
  @@index([administeredAt])
  @@index([nextDoseDate])
  @@map("vaccination_records")
}

// Analytics Model - Track usage and metrics
model Analytics {
  id                String    @id @default(uuid())
  cabinetId         String

  // Metrics
  metric            String    // appointments_created, no_shows, revenue, etc.
  value             Decimal   @db.Decimal(15, 2)
  count             Int       @default(1)

  // Dimensions
  date              DateTime
  practitionerId    String?
  metadata          Json?     // Additional context

  createdAt         DateTime  @default(now())

  @@index([cabinetId])
  @@index([metric])
  @@index([date])
  @@map("analytics")
}

// Audit Log Model - Track all important actions
model AuditLog {
  id                String    @id @default(uuid())
  userId            String?

  action            String    // CREATE, UPDATE, DELETE, LOGIN, etc.
  entity            String    // User, Patient, Appointment, etc.
  entityId          String?

  oldValues         String?   // JSON
  newValues         String?   // JSON

  ipAddress         String?
  userAgent         String?

  createdAt         DateTime  @default(now())

  // Relations
  user              User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}
